#!/usr/bin/env bash
# Terminal Talk one-line installer for macOS / Linux.
#
# Usage:
#   curl -fsSL https://benfrancisburns-creator.github.io/terminal-talk/install | bash
#
# What it does, in order:
#   1. macOS: ensures Homebrew is installed and `brew install`s
#      node, python@3.12, portaudio. Linux: verifies node + python3 +
#      git are on PATH (does NOT auto-install — distro package
#      managers vary too widely for that).
#   2. Clones (or pulls) the Terminal Talk repo to `~/code/terminal-talk`
#      (override with TT_CLONE_DIR=/somewhere/else).
#   3. Runs `install.sh --unattended` so the whole flow is non-
#      interactive — wake-word deps, hook registration, statusline,
#      and the macOS-only Quartz/Cocoa deps all install in one pass.
#
# Why no DMG / .pkg: this matches the audience (developers who already
# use the CLI) and avoids the Apple-Developer-ID / Gatekeeper hoop the
# DMG path would require. The DMG target lives in app/package.json
# for the future when code signing is in place.

set -euo pipefail

REPO_URL='https://github.com/benfrancisburns-creator/terminal-talk'
DEFAULT_DIR="$HOME/code/terminal-talk"
INSTALL_DIR="${TT_CLONE_DIR:-$DEFAULT_DIR}"

say()   { printf '\033[1;34m==>\033[0m %s\n' "$*"; }
warn()  { printf '\033[1;33m==>\033[0m %s\n' "$*" >&2; }
abort() { printf '\033[1;31m==>\033[0m %s\n' "$*" >&2; exit 1; }

# `update` mode: existing user re-running the curl line to pull new
# commits from origin/main. Skips the brew prereq dance (already done
# on first install), git-pulls, and tells install.sh to leave the
# venv + npm deps alone — just refresh the bundled scripts and config
# scaffolding. Followed by a hot-restart of the toolbar so the new
# code lands without the user having to pkill manually.
MODE='install'
if [ "${1:-}" = 'update' ]; then
  MODE='update'
  shift
fi

OS_NAME="$(uname -s)"
case "$OS_NAME" in
  Darwin) PLATFORM=macos ;;
  Linux*) PLATFORM=linux ;;
  *) abort "Unsupported OS: $OS_NAME. The one-line installer covers macOS and Linux only. On Windows, run install.ps1 from a clone instead." ;;
esac

say "Terminal Talk $MODE · platform=$PLATFORM · dir=$INSTALL_DIR"

# ---------------------------------------------------------------------------
# 1. Prereqs
# ---------------------------------------------------------------------------

if [ "$MODE" = 'update' ]; then
  # Update path: skip brew bootstrap entirely (already done on first install).
  if [ ! -d "$INSTALL_DIR/.git" ]; then
    abort "No existing install at $INSTALL_DIR. Run the installer without 'update' first."
  fi
  if [ "$PLATFORM" = 'macos' ] && [ -x /opt/homebrew/bin/brew ]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
  elif [ "$PLATFORM" = 'macos' ] && [ -x /usr/local/bin/brew ]; then
    eval "$(/usr/local/bin/brew shellenv)"
  fi
elif [ "$PLATFORM" = "macos" ]; then
  if ! command -v brew >/dev/null 2>&1; then
    say ""
    say "Homebrew is not installed — Terminal Talk needs it to fetch:"
    say "  · node       → runs the Electron toolbar"
    say "  · python@3.12 → runs the wake-word listener + TTS bridge"
    say "  · portaudio  → C library the Python wake-word listener links against"
    say ""
    say "About to run the official Homebrew installer (it'll ask for your"
    say "password — that grants the installer write access to /opt/homebrew."
    say "If you'd rather install Homebrew yourself first, press Ctrl+C now,"
    say "run the command at https://brew.sh, then re-run this installer)."
    say ""
    /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    if [ -x /opt/homebrew/bin/brew ]; then
      eval "$(/opt/homebrew/bin/brew shellenv)"
    elif [ -x /usr/local/bin/brew ]; then
      eval "$(/usr/local/bin/brew shellenv)"
    else
      abort "Homebrew install reported success but neither /opt/homebrew nor /usr/local has the brew binary. Re-run after sourcing it manually."
    fi
  fi
  for pkg in node python@3.12 portaudio; do
    if ! brew list --versions "$pkg" >/dev/null 2>&1; then
      say "brew install $pkg"
      brew install "$pkg"
    else
      say "brew: $pkg already installed"
    fi
  done
fi

if [ "$PLATFORM" = "linux" ]; then
  missing=()
  for cmd in git node npm python3; do
    if ! command -v "$cmd" >/dev/null 2>&1; then
      missing+=("$cmd")
    fi
  done
  if [ "${#missing[@]}" -gt 0 ]; then
    abort "Missing prereqs: ${missing[*]}. Install with your distro's package manager (apt / dnf / pacman / etc.) and re-run."
  fi
fi

if ! command -v git >/dev/null 2>&1; then
  abort "git is required and was not found on PATH."
fi

# ---------------------------------------------------------------------------
# 2. Clone (or pull) the repo
# ---------------------------------------------------------------------------

if [ -d "$INSTALL_DIR/.git" ]; then
  say "Repo already cloned at $INSTALL_DIR — fast-forward pulling."
  git -C "$INSTALL_DIR" pull --ff-only
else
  parent="$(dirname "$INSTALL_DIR")"
  mkdir -p "$parent"
  if [ -e "$INSTALL_DIR" ]; then
    abort "$INSTALL_DIR exists but isn't a git repo. Move/delete it or set TT_CLONE_DIR=… and re-run."
  fi
  say "Cloning $REPO_URL → $INSTALL_DIR"
  git clone --depth 1 "$REPO_URL" "$INSTALL_DIR"
fi

# ---------------------------------------------------------------------------
# 3. Hand off to install.sh
# ---------------------------------------------------------------------------

cd "$INSTALL_DIR"

# Pass any args after `bash` through to install.sh so `curl … | bash -s --
# --no-codex-hooks` works. Default to --unattended so curl-pipe is non-
# interactive end-to-end. Update mode adds --skip-python-deps and
# --skip-npm-install so the venv + node_modules survive the refresh
# untouched (the install.sh node_modules-preservation fix covers the
# tar/rm race regardless, but skipping the npm install also saves a
# 30-60 s wait when the user just wants new app code).
extra_args=("$@")
if [ "${#extra_args[@]}" -eq 0 ]; then
  if [ "$MODE" = 'update' ]; then
    extra_args=(--unattended --skip-python-deps --skip-npm-install)
  else
    extra_args=(--unattended)
  fi
fi

if [ "$PLATFORM" = "macos" ]; then
  brew_prefix="$(brew --prefix)"
  TT_PYTHON_EXE="$brew_prefix/bin/python3.12" bash install.sh "${extra_args[@]}"
else
  bash install.sh "${extra_args[@]}"
fi

# Update mode hot-restarts the toolbar so the new app/ code lands
# without the user having to pkill manually. First-install does NOT
# auto-launch — first launch needs the user present to grant the
# Accessibility + Microphone permission prompts.
if [ "$MODE" = 'update' ] && [ "$PLATFORM" = 'macos' ]; then
  say ""
  say "Restarting toolbar to pick up the new code…"
  pkill -f 'Electron.app/Contents/MacOS/Electron \.' 2>/dev/null || true
  sleep 1
  if [ -x "$HOME/.terminal-talk/start-toolbar.sh" ]; then
    nohup "$HOME/.terminal-talk/start-toolbar.sh" >/dev/null 2>&1 &
    say "Toolbar restarted (background)."
  fi
fi

say ""
if [ "$MODE" = 'update' ]; then
  say "Terminal Talk updated."
  say "Latest commit: $(git -C "$INSTALL_DIR" log -1 --pretty=format:'%h %s')"
else
  say "Terminal Talk is installed."
  say "Launch it any time with:"
  say "  $HOME/.terminal-talk/start-toolbar.sh"
  say ""
  say "First run will prompt for Accessibility (synthetic Cmd+C for highlight-to-speak)"
  say "and Microphone (wake-word listener). Both are one-time grants in System Settings."
  say ""
  say "Update later with:"
  say "  curl -fsSL https://benfrancisburns-creator.github.io/terminal-talk/install | bash -s update"
fi
