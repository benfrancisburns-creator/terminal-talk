# Node
node_modules/
package-lock.json

# Python
__pycache__/
*.pyc
.codex-transcribe-*/

# electron-builder output (Windows installer + portable .exe artefacts)
dist/
build-resources/
app/dist/

# Runtime state (shouldn't be committed)
app/listening.state
app/node_modules/

# User queue + logs (created at install time, not tracked)
queue/
*.log
*.wav
*.mp3
*.partial

# OS
.DS_Store
Thumbs.db
desktop.ini

# Editor
.vscode/
.idea/
*.swp

# Playwright artefacts (tests themselves ARE tracked — these are outputs)
/test-results/
/playwright-report/
/playwright/.cache/
/tmp/

# render-mocks.cjs and palette-pixel-diff.cjs scratch output
/.tmp-mocks/
/.tmp-pixel-diff/
/coverage/

# SonarQube local scan artefacts + token
.sonarqube-token
.scannerwork/
.tmp-*.json

# Internal development scaffolding — local-only; not public-facing.
Claude Assesments/
GHRC/
.claude/
iNPLAY IMAGES/

# coord/ — entire dir is internal multi-terminal coordination
# machinery. Files live in the working tree for active dev use but
# aren't tracked. Recover historical content via:
#   git log --all --oneline -- coord/<path>
#   git show <sha>:coord/<path>
# See `.archive-notes.md` for the 2026-04-26 untrack rationale.
coord/

# Empty placeholder dirs that historically existed at root
Assesments/
IMAGES/

# Internal coordination + assessment scaffolding — local-only working
# notes that should never be public. Files listed here may have been
# tracked previously; pair this with `git rm --cached` to untrack and
# (separately) consider `git filter-repo` to scrub history before
# launch.
COORDINATION.md
AGENTS.md
ASSESSMENTS/
docs/SESSION-HANDOFF-*.md
docs/LIVE-*.log
docs/VIDEO_*.md
docs/COMMAND_CENTER_*.md
docs/PAGE_HARVEST_CONCEPT.md
docs/TERMINAL_SESSION_LAUNCHER_CONCEPT.md
