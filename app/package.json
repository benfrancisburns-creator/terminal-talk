{
  "name": "terminal-talk",
  "version": "0.6.0",
  "private": true,
  "description": "Voice wake word + TTS playback for Claude Code, Codex CLI and highlight-to-speak workflows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "pack": "electron-builder --dir",
    "build:win": "electron-builder --win --x64",
    "build:winnsis": "electron-builder --win nsis --x64",
    "build:winportable": "electron-builder --win portable --x64",
    "build:mac": "electron-builder --mac --arm64 --x64"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "41.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.benfrancisburns.terminal-talk",
    "productName": "Terminal Talk",
    "copyright": "Copyright (c) 2026 Ben Burns",
    "directories": {
      "output": "../dist",
      "buildResources": "../build-resources"
    },
    "files": [
      "**/*",
      "!**/*.{md,test.js,spec.js}",
      "!**/.{git,gitignore,gitattributes,DS_Store,vscode}",
      "!**/{.eslintrc,.eslintignore,.npmignore}",
      "!**/{tsconfig.json,jsconfig.json}",
      "!**/node_modules/**/{test,tests,__tests__,example,examples,docs,doc}/**",
      "!**/node_modules/**/*.{md,markdown,d.ts,map}",
      "!**/node_modules/**/{LICENSE,license,LICENCE,licence,CHANGELOG,changelog,changes,HISTORY,history}*",
      "!.tmp_synth/**"
    ],
    "extraResources": [
      {
        "from": "../hooks",
        "to": "hooks",
        "filter": ["**/*"]
      },
      {
        "from": "../requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "../requirements-wakeword.txt",
        "to": "requirements-wakeword.txt"
      },
      {
        "from": "../requirements-mac.txt",
        "to": "requirements-mac.txt"
      }
    ],
    "asar": true,
    "asarUnpack": [
      "**/lib/palette-classes.css",
      "**/synth_turn.py",
      "**/edge_tts_speak.py",
      "**/openai_tts.py",
      "**/sentence_split.py",
      "**/sentence_group.py",
      "**/tool_narration.py",
      "**/text_strip.py",
      "**/wake-word-listener.py",
      "**/key_helper.py",
      "**/posix_hooks.py",
      "**/statusline.py",
      "**/claude_footer_scrape.py"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "category": "public.app-category.utilities",
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Terminal Talk listens for the wake word \"hey jarvis\" so it can read highlighted text aloud. Audio is processed locally by openWakeWord; no recordings leave your machine.",
        "NSAppleEventsUsageDescription": "Terminal Talk synthesises a Cmd+C keystroke to copy the currently highlighted text when you press the speak-clipboard hotkey or fire the wake word."
      }
    },
    "dmg": {
      "artifactName": "${productName}-${version}-${arch}.dmg",
      "writeUpdateInfo": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Terminal Talk",
      "uninstallDisplayName": "Terminal Talk ${version}",
      "deleteAppDataOnUninstall": false
    },
    "portable": {
      "artifactName": "${productName}-Portable-${version}.${ext}"
    },
    "publish": null
  }
}
